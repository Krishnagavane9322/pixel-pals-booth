# ==========================================
# ROVI AI Photo Booth - Environment Variables
# ==========================================

# Server Environment
NODE_ENV=development
PORT=3000

# Vercel Blob Cloud Storage (Optional for local dev)
# If provided, photo strips will be uploaded to Vercel Blob storage.
# If omitted/blank, the server automatically falls back to local disk storage (public/photos/).
BLOB_READ_WRITE_TOKEN=

# Public Frontend Configuration (Client-accessible via import.meta.env)
VITE_APP_TITLE="ROVI AI Photo Booth"
VITE_PUBLIC_URL="http://localhost:3000"
